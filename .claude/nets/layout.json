{
  "about": "Where a file of the .claude tree may be. * matches inside one folder name, ** any number of folders.",
  "allow": [
    "project.json",
    "entry/*.py",
    "harness/__init__.py",
    "harness/utils/*.py",
    "harness/mcp/*.py",
    "harness/gear/*.py",
    "harness/gear/rules/*.json",
